{
  "name": "emaki-vscode",
  "displayName": "Emaki",
  "description": "Write Emaki visual novel scripts (.vn): highlighting, live error checking, go to definition, completion, outline and formatting.",
  "version": "0.1.0",
  "publisher": "emaki",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AbhishekNair050/Emaki.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "visual novel",
    "interactive fiction",
    "emaki",
    "vn"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "emaki",
        "aliases": [
          "Emaki",
          "emaki"
        ],
        "extensions": [
          ".vn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "emaki",
        "scopeName": "source.emaki",
        "path": "./syntaxes/emaki.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[emaki]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.wordWrap": "on"
      }
    },
    "commands": [
      {
        "command": "emaki.previewLine",
        "title": "Preview from This Line",
        "category": "Emaki",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "emaki.previewLine",
          "when": "editorLangId == emaki",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "emaki.previewLine",
          "when": "editorLangId == emaki",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "emaki.previewLine",
          "when": "editorLangId == emaki"
        }
      ]
    },
    "keybindings": [
      {
        "command": "emaki.previewLine",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == emaki"
      }
    ],
    "configuration": {
      "title": "Emaki",
      "properties": {
        "emaki.preview.url": {
          "type": "string",
          "default": "http://localhost:5173/",
          "markdownDescription": "Address of the running dev server (`npm run dev`)."
        },
        "emaki.preview.openIn": {
          "type": "string",
          "enum": [
            "beside",
            "browser"
          ],
          "enumDescriptions": [
            "VS Code's built-in browser, next to the script",
            "Your default web browser"
          ],
          "default": "beside",
          "description": "Where \"Preview from This Line\" opens the game."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.cjs",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@emaki/format": "0.1.0",
    "@emaki/language": "0.1.0",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.25.12",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
