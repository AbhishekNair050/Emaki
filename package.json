{
  "name": "emaki",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "emaki": "node packages/cli/src/main.ts",
    "launch": "node packages/cli/src/main.ts launch",
    "studio": "electron packages/studio",
    "build:studio": "node packages/studio/build.ts",
    "check": "node packages/cli/src/main.ts check games/gullwing/story.vn",
    "fmt": "node packages/cli/src/main.ts fmt games/gullwing/story.vn --write",
    "fmt:check": "node packages/cli/src/main.ts fmt games/gullwing/story.vn --check",
    "strings": "node packages/cli/src/main.ts strings games/gullwing/story.vn",
    "dev": "vite --config packages/player-web/vite.config.ts",
    "edit": "vite --config packages/editor/vite.config.ts",
    "build:demo": "vite build --config packages/player-web/vite.config.ts",
    "build:site": "node site/build.mjs",
    "preview:site": "vite preview --outDir site/dist/public",
    "export": "node packages/cli/src/main.ts export",
    "build:vscode": "npm run build -w emaki-vscode",
    "art": "node games/gullwing/tools/gen-art.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
